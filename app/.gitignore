# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/

# Virtualenv — reproducible from doc/requirements-*.txt
.venv/

# Runtime state — session transcripts, evidence, audit logs, secrets, caches.
# Everything under here is generated by running the agent, not source.
agent/state/

# Runtime engagement instances (agent/engagement/intake.py-created dirs) — the
# lab-default engagement/ (roe.json/scope.txt/deny.txt) is tracked; per-engagement
# state.db instances under engagements/ are not.
engagements/*/

# Editor/OS cruft
.DS_Store
*.swp

# SFT dataset workspace (multi-GB, generated corpora — not source for this repo)
datasets/

# Knowledge-RAG: cloned reference repos, the downloaded embedding model, and the built vector
# index are all reproducible from parsers.py + build_index.py — not source. See
# agent/knowledge_rag/build_index.py's docstring to regenerate.
agent/knowledge_rag/corpus_src/
agent/knowledge_rag/models/
agent/knowledge_rag/index/
agent/knowledge_rag/embed_server.log

# Old v1 mockups (superseded by v2)
ai-web-platform-mockups/

# Electron build artifacts
electron/node_modules/
electron/dist/
electron/out/

# Electron / Node
node_modules/
dist/

# Oxpecker dev_server runtime state (sessions, findings, RAG offsets)
agent/web/dev_data/
agent/knowledge_rag/index/*.offsets.npy

# Private machine-specific runtime config (paths to llama/model/RAG) — never commit or ship
electron/config.local.json
